{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "jsxImportSource": "nativewind",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "allowJs": true,
    "verbatimModuleSyntax": false,
    "exactOptionalPropertyTypes": false,
    "types": ["react"]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "assets.d.ts",
    "nativewind.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
