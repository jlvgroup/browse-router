auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
# Flatten node_modules under apps/mobile so Metro/gradle can resolve
# packages like `babel-preset-expo` from the gradle task's working dir.
# (pnpm's default hoisting keeps them in the root .pnpm/ store, which
# Metro doesn't traverse when cwd is apps/mobile/android.)
node-linker=hoisted
public-hoist-pattern[]=*
